{
  "name": "svg-board",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-style.mjs",
    "format": "prettier --write src scripts tests *.ts *.json *.html README.md",
    "format:check": "prettier --check src scripts tests *.ts *.json *.html README.md",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "examples": "tsx scripts/build-examples.ts",
    "package": "npm run build && node scripts/package.mjs",
    "build": "npm run typecheck && vite build && node scripts/copy-notices.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@flatten-js/core": "^1.6.8",
    "d3-array": "^3.2.5",
    "dompurify": "^3.4.18",
    "fabric": "^7.4.0",
    "lucide": "^0.468.0",
    "marked": "^18.2.0",
    "mathjs": "^15.2.0",
    "ml-regression-polynomial": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/d3-array": "^3.2.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jszip": "^3.10.2",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
