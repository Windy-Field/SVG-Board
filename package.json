{
  "name": "svg-board",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-style.mjs",
    "format": "prettier --write src scripts tests *.ts *.json *.css *.html README.md",
    "format:check": "prettier --check src scripts tests *.ts *.json *.css *.html README.md",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "build": "npm run typecheck && vite build && node scripts/copy-notices.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@flatten-js/core": "^1.6.8",
    "fabric": "^7.4.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
